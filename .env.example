# Copy to .env.local for development. In production set these in Vercel (Project Settings, Environment Variables). Never commit real values.

# --- Supabase (Project Settings, API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row level security. Used for the shared rate limiter, account deletion and the cleanup job. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Public address of the site, no trailing slash. Used in sitemaps, canonical links and email confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the Contact page.
CONTACT_EMAIL=hello@example.org
# Long random string. Vercel Cron sends it so only the scheduler can call /api/cron/cleanup (generate with: openssl rand -hex 32).
CRON_SECRET=

# --- Optional: only needed by the scripts, not by the website ---
# Direct Postgres connection string (Project Settings, Database) used by scripts/backup.sh.
DATABASE_URL=
